# Discord Bot Token (required)
# Get yours at https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Bot Client ID (required for slash commands)
CLIENT_ID=your_client_id_here

# MongoDB Connection URI (required)
# Get yours at https://cloud.mongodb.com or use local mongodb://localhost:27017/bot
MONGO_URI=mongodb://localhost:27017/enerthya-bot

# Guild ID for guild-specific commands (optional)
# GUILD_ID=your_guild_id_here

# Bot Owner Discord ID (optional — enables owner-only commands)
# OWNER_ID=your_discord_user_id

# Error Webhook URL (optional — sends crash reports to a Discord channel)
# ERROR_WEBHOOK=https://discord.com/api/webhooks/...

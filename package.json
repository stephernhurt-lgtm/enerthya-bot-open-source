{
  "name": "enerthya-bot-open-source",
  "version": "1.0.0",
  "description": "A modular, open-source Discord.js v14 bot template — ready to build and extend.",
  "author": "stephernhurt-lgtm",
  "license": "AGPL-3.0-only",
  "main": "dist/index.js",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && tsc-alias",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write src/",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "sync": "tsx src/scripts/sync.ts",
    "sync:list": "tsx src/scripts/sync.ts --list",
    "sync:clear": "tsx src/scripts/sync.ts --clear"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "dayjs": "^1.11.21",
    "discord.js": "^14.18.0",
    "dotenv": "^17.4.2",
    "mongoose": "^9.8.0",
    "tsx": "^4.23.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/node": "^26.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "tsc-alias": "^1.8.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "packageManager": "yarn@1.22.22"
}

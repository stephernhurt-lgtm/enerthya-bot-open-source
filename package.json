{
  "name": "enerthya-bot-open-source",
  "version": "1.0.0",
  "description": "A modular, open-source Discord.js v14 bot template — ready to build and extend.",
  "author": "stephernhurt-lgtm",
  "license": "MIT",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && tsc-alias",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write src/",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "discord.js": "^14.18.0",
    "dotenv": "^17.4.2",
    "mongoose": "^9.8.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "tsc-alias": "^1.8.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "packageManager": "yarn@1.22.22"
}
